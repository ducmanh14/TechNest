{
  "name": "technest",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "db:setup": "npm run db:setup -w server",
    "test": "npm run test -w server",
    "test:integration": "npm run test:integration -w server"
  },
  "devDependencies": {
    "concurrently": "9.2.5"
  }
}